{
  "name": "vision-aid",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "serve": "expo serve",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/**/*.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:production && npm run build:web",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@react-navigation/native": "^7.3.11",
    "expo": "^57.0.7",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.6",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-speech": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "jose": "^6.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
