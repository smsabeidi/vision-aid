# Runtime posture. Production fails closed without authentication and distributed state.
VISIONAID_RUNTIME_ENV=development
VISIONAID_TELEMETRY_ENABLED=false

# Primary perception provider: NVIDIA Cosmos 3 Nano Reasoner through a private
# NIM or vLLM OpenAI-compatible endpoint. Never expose these in EXPO_PUBLIC_*.
VISION_PROVIDER=nvidia
NVIDIA_COSMOS_BASE_URL=
NVIDIA_COSMOS_API_KEY=
NVIDIA_COSMOS_MODEL=nvidia/cosmos3-nano-reasoner
NVIDIA_COSMOS_TIMEOUT_MS=25000

# Optional rollback provider. Set VISION_PROVIDER=openai to use it.
OPENAI_API_KEY=

# Task/risk routing. Legacy OPENAI_MODEL remains supported as a global override.
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_QUALITY=gpt-5.6-sol
OPENAI_MODEL_FALLBACK=gpt-5.6-sol
# OPENAI_MODEL_DESCRIBE=
# OPENAI_MODEL_READ=
# OPENAI_MODEL_FIND=

# Optional bounded model budgets by mode.
# OPENAI_IMAGE_DETAIL_DESCRIBE=high
# OPENAI_IMAGE_DETAIL_READ=original
# OPENAI_IMAGE_DETAIL_FIND=high
# OPENAI_REASONING_EFFORT_DESCRIBE=none
# OPENAI_REASONING_EFFORT_READ=low
# OPENAI_REASONING_EFFORT_FIND=low
# OPENAI_TIMEOUT_MS_DESCRIBE=20000
# OPENAI_TIMEOUT_MS_READ=28000
# OPENAI_TIMEOUT_MS_FIND=24000

# Standards-based JWT verification at the API boundary.
# Strict production always requires auth; this flag can also enable it in other environments.
AUTH_REQUIRED=false
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_REQUIRED_SCOPE=analysis:write
AUTH_NAVIGATION_SCOPE=navigation:route
AUTH_ALLOWED_ALGORITHMS=RS256,ES256

# Required in production for atomic distributed rate limits and idempotency.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-side pedestrian/step-free route planning. For the hosted service use
# https://api.openrouteservice.org; a self-hosted deployment can use its /ors base.
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_API_KEY=

# Comma-separated exact browser origins. Native clients do not send Origin.
ALLOWED_ORIGINS=

# Server-side sample responses default off in strict production.
ALLOW_API_DEMO=true

# Public origin only; never include credentials. The client appends /api/v1/analyze.
EXPO_PUBLIC_API_URL=
